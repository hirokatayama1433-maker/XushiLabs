{
    "name": "xushilabs/xushiui",
    "description": "CSS token-driven UI component engine for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Xushi\\UI\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Xushi\\UI\\XushiServiceProvider"
            ],
            "aliases": {
                "Xushi": "Xushi\\UI\\Xushi"
            }
        }
    }
}
